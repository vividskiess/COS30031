[sub_resource type="GDScript" id="GDScript_1qxhi"]
script/source = "extends Node

@onready var click_sound_player: AudioStreamPlayer = $ClickSoundPlayer

# The maximum time (in seconds) to be considered a \"click\" vs a \"hold\"
const CLICK_THRESHOLD = 0.2 

var press_time: float = 0.0

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if event.pressed:
			# Record the exact time the mouse was pressed
			press_time = Time.get_ticks_msec() / 1000.0
		else:
			# Mouse was released. Calculate how long it was held.
			var release_time = Time.get_ticks_msec() / 1000.0
			var duration = release_time - press_time
			
			# Only play sound if the release happened quickly
			if duration < CLICK_THRESHOLD:
				play_click_sound()

func play_click_sound() -> void:
	click_sound_player.pitch_scale = randf_range(0.98, 1.02)
	click_sound_player.play()
"

